<header id="site-header">
	<div id="header-inner">
		<h1>Dan Crooks</h1>
		<nav>
			<a href="/">Home</a>
			<a href="/about">About</a>
			<a href="/posts">Blog</a>
		</nav>
	</div>
</header>

<style>
	#site-header {
		width: 100%;
		background-color: #1a1a2e;
		color: white;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1rem 2rem;
		box-sizing: border-box;
	}
	#header-inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		width: 100%;
		text-align: center;
	}
	#site-header h1 {
		margin: 0;
		font-size: 2.2rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		font-family: sans-serif;
	}
	nav {
		display: flex;
		gap: 1.5rem;
	}
	nav a {
		color: white;
		text-decoration: none;
		font-size: 1rem;
	}
	nav a:hover {
		text-decoration: underline;
	}
</style>
